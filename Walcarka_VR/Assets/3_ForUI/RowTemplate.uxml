<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; width: 100%; height: 35px; align-items: center; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-outline-width: 1px;">
        <ui:Label text="Label" name="TimeLabel" style="width: 25%; font-size: 60px;"/>
        <ui:Label text="Label" name="VelocityLabel" style="width: 25%; font-size: 60px; height: 100%; flex-grow: 0;"/>
        <ui:Label text="Label" name="CurrentLabel" style="width: 25%; font-size: 60px; flex-grow: 0;"/>
        <ui:Label text="Label" name="TorqueLabel" style="width: 25%; font-size: 60px; flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
